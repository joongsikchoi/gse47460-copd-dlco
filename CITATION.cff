    given-names: Kangjin
    affiliation: Department of Applied Statistics, Gachon University, Seongnam, Republic of Korea
repository-code: https://github.com/joongsikchoi/gse47460-copd-dlco
license: MIT
keywords:
  - COPD
  - diffusing capacity
  - DLCO
  - gene expression
  - cell-type deconvolution
  - alveolar capillary
  - lung tissue
  - microarray
  - GSE47460
